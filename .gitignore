# R
.Rhistory
.Rdata
.RData
.Ruserdata
*.Rproj.user

# renv
renv/library/
renv/staging/
renv/python/
renv/sandbox/
renv/activate.R

# targets cache (large, reproducible from code)
_targets/
*_targets.yaml

# Data files (often large, should be stored elsewhere)
data/
!data/.gitkeep
docs/**/*.pdf

# Output files (reproducible from code)
output/*
!output/.gitkeep
*.typ

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Quarto
/.quarto/
*_files/
*_cache/
*.html
_freeze/
_extensions/
_manuscript/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# Environment variables (NEVER commit secrets)
.env
.env.local
*.env

# Claude Code
.claude/*
!.claude/skills/

# Temporary files
*.tmp
*.temp
*.log
stata/
**/*.quarto_ipynb
